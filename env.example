# Образец файла /app/.env для новой установки. Скопировать: cp env.example .env && chmod 600 .env
# Значения подставить свои. Без кавычек и пробелов вокруг "=". Файл .env в git не попадает.

# ---------- ОБЯЗАТЕЛЬНО ----------
# Адрес сайта: https://, без слэша в конце. Из него строятся ссылки на подписание договора в письмах гостям.
BASE_URL=https://example.ru
# Пароль для первого входа в админку (потом его можно сменить в самой админке).
ADMIN_PASSWORD=
# Длинная случайная строка: python3 -c "import secrets;print(secrets.token_hex(32))"
# Без неё после каждого перезапуска придётся заново входить в админку.
SESSION_SECRET=
# Почтовый ящик, с которого уходят письма гостям (по умолчанию smtp.mail.ru:465), и пароль приложения этого ящика.
MAIL_FROM=
MAIL_PASSWORD=
# Пароль, которым шифруются резервные копии (придумать и сохранить в надёжном месте: без него копии не открыть).
# Пусто = копии не шифруются и на почту не отправляются.
BACKUP_PASSWORD=

# ---------- НЕОБЯЗАТЕЛЬНО ----------
# Почта для служебных писем (сбои, копии). Пусто = берётся почта из раздела «Контакты» в админке.
MAIL_ADMIN=
# Имя отправителя в письмах (пусто = название из раздела «Бренд»).
MAIL_FROM_NAME=
# Другой почтовый сервер (по умолчанию smtp.mail.ru и 465).
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
# NOINDEX=1 запрещает поисковикам индексировать сайт: для тестовой копии. Для рабочего сайта строку удалить.
NOINDEX=1

# Telegram-бот не используется: BOT_TOKEN и ADMIN_IDS не нужны.
